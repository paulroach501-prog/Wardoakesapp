// Ward & Oakes — Forensic Condition Assessment app
// Data model. The Customer (contact) → Property (1+) relationship is the
// backbone: every report, measurement, and inspection attaches to a Property.
//
// Uses Postgres (Vercel Postgres / Neon). The two URLs are the standard pair
// the Vercel Postgres integration injects automatically:
//   POSTGRES_PRISMA_URL      — pooled connection for the running app
//   POSTGRES_URL_NON_POOLING — direct connection for migrations / db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Customer {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firstName   String
  lastName    String
  companyName String?
  email       String?
  phone       String?
  notes       String?

  properties  Property[]

  @@index([lastName, firstName])
}

model Property {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // A friendly label, e.g. "Primary residence" or "Rental — 2nd St".
  label      String?

  street     String
  city       String
  state      String
  zip        String

  reports    Report[]
  measurements Measurement[]

  @@index([customerId])
}

// A generated deliverable for a property. The first type is the Weather &
// Property History Report; the same model will hold future report types.
model Report {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // "WEATHER_HISTORY" for now; reserved for future report types.
  type       String   @default("WEATHER_HISTORY")
  // GENERATING | READY | FAILED
  status     String   @default("GENERATING")

  // Which AI engine + model produced the research (null if none).
  aiProvider String?
  aiModel    String?

  // Structured research output (narrative + findings + sources).
  findings   Json?
  // Branded PDF: either a hosted Blob URL, or inline bytes as a fallback
  // before object storage is configured.
  pdfUrl     String?
  pdfData    Bytes?

  error      String?

  @@index([propertyId])
}

// A roof/siding measurement for a property: the underlay image, the scale
// calibration, and the drawn planes. Geometry is stored as JSON so the drawing
// model can evolve without migrations.
model Measurement {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // "ROOF" | "SIDING"
  kind       String   @default("ROOF")
  label      String?

  // Underlay image: hosted Blob URL, or inline bytes before Blob is configured.
  imageUrl   String?
  imageData  Bytes?
  imageWidth Int?
  imageHeight Int?

  // Real-world feet per image pixel, from the calibration step (null until set).
  feetPerPixel Float?

  // Array of planes: { id, name, pitch, points:[{x,y}], edgeTypes:[string] }.
  planes     Json?

  @@index([propertyId])
}

// Simple key/value app settings (e.g. default AI provider + model per task).
// Keyed strings like "report.provider" / "report.model".
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
