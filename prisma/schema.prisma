// Ward & Oakes — Forensic Condition Assessment app
// Data model. The Customer (contact) → Property (1+) relationship is the
// backbone: every report, measurement, and inspection attaches to a Property.
//
// Dev uses SQLite for zero-setup local runs. To move to Postgres, change the
// datasource provider to "postgresql" and point DATABASE_URL at your instance —
// the models below are written to port cleanly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  firstName   String
  lastName    String
  companyName String?
  email       String?
  phone       String?
  notes       String?

  properties  Property[]

  @@index([lastName, firstName])
}

model Property {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // A friendly label, e.g. "Primary residence" or "Rental — 2nd St".
  label      String?

  street     String
  city       String
  state      String
  zip        String

  @@index([customerId])
}
