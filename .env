# Database connection. In production these are injected automatically by the
# Vercel Postgres integration. For local development, paste your database's
# connection strings here (e.g. from a free Neon project), or run `vercel env
# pull` to fetch them.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# --- Optional integrations (the app runs without these) ---

# AI research engines for the Weather & Property History Report. Set either or
# both; the in-app selector offers whichever are configured.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# File storage for generated PDFs/photos. Injected automatically once you create
# a Vercel Blob store. Without it, PDFs are stored inline in the database.
BLOB_READ_WRITE_TOKEN=""

# NOAA NCEI CDO token — enables the station-flag/gust layer of the storm-history
# engine (LSR storm reports still run without it). Get one free at
# https://www.ncdc.noaa.gov/cdo-web/token
CDO_TOKEN=""
